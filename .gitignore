# ============================================================
# 开发过程遗留物（与产品无关，不纳入版本控制）
# 见 BeeOffice-优化规划.md 阶段 0.1
# ============================================================
# 历史源码副本：变更历史改由 git 承载
backup/
# 开发时的样例文档与图片（仅 tools/diagnose_image.py 以硬编码路径引用，无测试依赖）
test+files/
# 一次性修补脚本（迁移已完成）
tools/migration/
# 批量生成测试 / 刷覆盖率的脚本，可复现性差且会被误当产品代码
create_tests.py
boost_coverage.py
finalize_session.py
# 与 AI 的对话记录，属开发过程材料
运行文档.txt
mslxt.txt
# 本地临时目录
_ptmp/
# 本地验证产物
_isolated_all.txt
_r.log

# ============================================================
# 保真度语料（tests/fidelity/corpus/）
# ------------------------------------------------------------
# 真实文档可能含内部信息（内网 IP、主机名、账号、客户内容），一旦提交进
# git 历史就很难撤回。因此**默认不纳入版本库**：文件照常放在本地即可被
# tools/fidelity_corpus.py 与 tests/fidelity/test_corpus.py 使用；
# 没有文件时相关测试会自动 skip（不会失败）。
#
# 如果你确认某份文件可以公开（例如已脱敏），有两种做法：
#   ① 删除下面这三行（或改用 ! 显式排除），再 git add 该文件；
#   ② 把脱敏后的样本改放到 test+files/（那个目录是入库的）。
# ============================================================
tests/fidelity/corpus/*.docx
tests/fidelity/corpus/*.xlsx
tests/fidelity/corpus/*.pptx

